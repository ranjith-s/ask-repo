# Which LLM answers questions: anthropic | gemini | ollama
LLM_PROVIDER=anthropic

# Set the key for the provider you use. Indexing works without any key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model. Leave unset for the provider default:
#   anthropic: claude-opus-5-5   (or claude-sonnet-5-5 for about half the cost)
#   gemini:    gemini-2.5-flash  (set a newer model id here if you prefer)
#   ollama:    qwen3:8b          (any model with tool support; run `ollama pull <model>` first)
# LLM_MODEL=

# Claude only: thinking effort. low | medium | high
# LLM_EFFORT=medium

# Ollama (outside Docker the default is http://localhost:11434)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_NUM_CTX=32768

# Prices in USD per million tokens, for the cost shown under each answer.
# Only needed for models missing from backend/app/agent/llm/pricing.py.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
# PRICE_CACHE_WRITE_PER_MTOK=
# PRICE_CACHE_READ_PER_MTOK=

# Other defaults
# AGENT_MAX_STEPS=8
# EMBEDDING_BACKEND=fastembed  # or "hash" for offline tests
# DATABASE_URL=postgresql://askrepo:askrepo@localhost:5432/askrepo
